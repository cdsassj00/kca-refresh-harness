# 근거 소스 API 키. 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올라가지 않는다.
# 권장 최소 세트
DATA_GO_KR_API_KEY=
# 공공데이터포털은 데이터셋(API)마다 인증키가 따로 나오는 경우가 많다.
# 받은 만큼 아래처럼 이름을 붙여 줄을 늘리면 된다(이름은 자유, 영문 대문자·숫자·밑줄).
#   DATA_GO_KR_KEY_KCI=<KCI 논문정보서비스 전용 키>
#   DATA_GO_KR_KEY_PRISM=<정책연구 과제정보 전용 키>
# DATA_GO_KR_API_KEY 는 전용 키가 없는 API 에 쓰는 기본값이다.

KOSIS_API_KEY=
LAW_GO_KR_OC=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 국내 추가
ASSEMBLY_API_KEY=
ECOS_API_KEY=
KCI_API_KEY=
NANET_API_KEY=
SCIENCEON_API_KEY=
# 해외
OPENALEX_MAILTO=
CROSSREF_MAILTO=
S2_API_KEY=
IEEE_API_KEY=
CORE_API_KEY=
SPRINGER_API_KEY=
LENS_API_TOKEN=
# 유료
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
WOS_API_KEY=
DIMENSIONS_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=
DBPIA_API_KEY=
BIGKINDS_API_KEY=
