# 근거 소스 API 키. 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올라가지 않는다.
# 권장 최소 세트
DATA_GO_KR_API_KEY=
# 공공데이터포털: 활용신청은 데이터셋(API)마다 따로 하지만 인증키는 계정에 하나다.
# 마이페이지의 '일반 인증키(Decoding)' 를 여기 한 번만 적으면 승인된 모든 API 에 쓰인다.
# (드물게 기관이 전용 키를 따로 주는 API 가 있으면 DATA_GO_KR_KEY_<이름> 으로 덧붙일 수 있다)

KOSIS_API_KEY=
LAW_GO_KR_OC=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 국내 추가
ASSEMBLY_API_KEY=
ECOS_API_KEY=
KCI_API_KEY=
NANET_API_KEY=
SCIENCEON_API_KEY=
# 해외
OPENALEX_MAILTO=
CROSSREF_MAILTO=
S2_API_KEY=
IEEE_API_KEY=
CORE_API_KEY=
SPRINGER_API_KEY=
LENS_API_TOKEN=
# 유료
ELSEVIER_API_KEY=
ELSEVIER_INSTTOKEN=
WOS_API_KEY=
DIMENSIONS_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
