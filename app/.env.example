# 독립 프로그램(app/) 설정 **견본**. run_app.bat 이 없으면 이 파일을 .env 로 복사한다.
# 이 파일은 git 에 올라간다. **여기에는 절대 실제 키를 적지 않는다.**
# 값은 브라우저 [설정] 화면에서 넣어도 된다. 발급처: ../docs/api_keys_guide.md

# ── 독립 프로그램(app/) 전용 — 하네스는 쓰지 않는다 ──
# [app 필수] OpenRouter 키 (sk-or-… ). openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI 호환 주소. 비우면 OpenRouter 기본값
LLM_BASE_URL=
# 기본 모델 ID (예: anthropic/claude-sonnet-5)
LLM_MODEL=
# 추출·분류처럼 가벼운 단계에 쓸 저가 모델. 비우면 기본 모델
LLM_MODEL_CHEAP=
# auto | tavily | exa | naver | openrouter_online
SEARCH_PROVIDER=

# ── 권장 최소 세트 — 이것만 있어도 국내 근거 수집이 돈다 ──
# 공공데이터포털. 마이페이지의 '일반 인증키(Decoding)'. 계정당 하나
DATA_GO_KR_API_KEY=
# 국가통계포털. 유효기간 2년, 만료되면 마이페이지에서 연장
KOSIS_API_KEY=
# 법제처. 긴 키가 아니라 짧은 기관 아이디(OC). 이메일 앞부분이 아니다
LAW_GO_KR_OC=
# NAVER 검색. API HUB 의 X-NCP-APIGW-API-KEY-ID
NAVER_CLIENT_ID=
# NAVER 검색. API HUB 의 X-NCP-APIGW-API-KEY
NAVER_CLIENT_SECRET=
# 비우면 API HUB. 예전 개발자센터를 쓰려면 legacy
NAVER_API_STYLE=

# ── 국내 추가 ──
# 열린국회정보. open.assembly.go.kr/portal/openapi/main.do
ASSEMBLY_API_KEY=
# 한국은행 경제통계. 통계표 코드를 알아야 값을 꺼낸다
ECOS_API_KEY=
# 한국학술지인용색인. open.kci.go.kr. 국내 논문 제목·기간 검색
KCI_API_KEY=
# 국회도서관. 학술논문·정책자료
NANET_API_KEY=
# KISTI ScienceON. 논문·특허·국가R&D 과제
SCIENCEON_API_KEY=

# ── 해외 — 위 둘은 키가 아니라 이메일 주소다(신청 없음) ──
# OpenAlex 우대 대기열용 이메일. 신청 절차 없음
OPENALEX_MAILTO=
# Crossref 우대 대기열용 이메일. 신청 절차 없음
CROSSREF_MAILTO=
# Semantic Scholar. 없어도 되지만 있으면 한도가 올라간다
S2_API_KEY=
# IEEE Xplore. 통신·전파 공학
IEEE_API_KEY=
# CORE. 오픈액세스 원문
CORE_API_KEY=
# Springer Nature
SPRINGER_API_KEY=
# Lens.org. 논문 + 특허. 비상업 무료
LENS_API_TOKEN=

# ── 웹 검색 ──
# Tavily (tvly-… ). app.tavily.com
TAVILY_API_KEY=
# Exa. dashboard.exa.ai
EXA_API_KEY=
# Perplexity
PERPLEXITY_API_KEY=
# SerpAPI (Google Scholar 경유)
SERPAPI_API_KEY=

# ── 유료·기관 구독 — 필요할 때만 ──
# Scopus/ScienceDirect
ELSEVIER_API_KEY=
# Elsevier 기관 토큰(기관 네트워크 밖에서 쓸 때)
ELSEVIER_INSTTOKEN=
# Web of Science
WOS_API_KEY=
# Dimensions
DIMENSIONS_API_KEY=
# DBpia
DBPIA_API_KEY=
# 빅카인즈(뉴스)
BIGKINDS_API_KEY=
