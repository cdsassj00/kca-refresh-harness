# 독립 프로그램(app/) 설정 파일 견본. run_app.bat 가 이 파일을 .env 로 복사한다.
# 필수는 OPENROUTER_API_KEY 하나뿐이다. 나머지는 모두 비워 두어도 동작한다.
# 값은 브라우저 [설정] 화면에서 넣는 것을 권장한다(저장하면 이 파일의 .env 가 갱신되고, 그때 주석은 사라진다).
# 발급처·절차: ../docs/api_keys_guide.md  (0절 OpenRouter·Tavily·Exa, 1~3절 근거 소스)
# .env 는 git 에 올라가지 않는다. 키 값을 화면·문서·로그에 붙여 넣지 않는다.

# ===== LLM (필수 1개) =====
# [필수] OpenRouter API 키 (sk-or-… 로 시작). openrouter.ai › Keys 에서 발급, 월 한도 설정 권장
OPENROUTER_API_KEY=
# OpenAI 호환 엔드포인트. 비우면 https://openrouter.ai/api/v1 . 다른 공급자 직접 호출·사내 서버는 여기를 바꾼다
LLM_BASE_URL=
# 기본 모델 ID (예: anthropic/claude-sonnet-4, openai/gpt-4.1). 비우면 openrouter/auto. 화면에서 고르면 settings.json 이 우선
LLM_MODEL=
# 추출·분류·브리프 같은 가벼운 단계용 저가 모델 (선택). 비우면 기본 모델을 쓴다
LLM_MODEL_CHEAP=

# ===== 웹 검색 공급자 (선택) =====
# auto | tavily | exa | naver | openrouter_online . auto 는 키가 있는 순서(tavily→exa→naver→openrouter_online)로 고른다
SEARCH_PROVIDER=
# Tavily 검색 키 (tvly-…). app.tavily.com 에서 발급, 무료 구간 있음
TAVILY_API_KEY=
# Exa 검색 키. dashboard.exa.ai 에서 발급
EXA_API_KEY=
# NAVER 검색(뉴스) Client ID. developers.naver.com 애플리케이션 등록
NAVER_CLIENT_ID=
# NAVER 검색 Client Secret (위 ID 와 한 쌍)
NAVER_CLIENT_SECRET=

# ===== 근거 소스: 키 없이 되는 곳 (이메일만 넣으면 우대 속도) =====
# OpenAlex polite pool 용 이메일 (선택)
OPENALEX_MAILTO=
# Crossref polite pool 용 이메일 (선택)
CROSSREF_MAILTO=
# Semantic Scholar 키 (선택, 없어도 동작하나 쿼터가 낮다)
S2_API_KEY=

# ===== 근거 소스: 국내 무료 키 (권장 최소 세트 → 검증 정확도 상승) =====
# 공공데이터포털 일반 인증키(Decoding). KCI 논문·통계 데이터셋
DATA_GO_KR_API_KEY=
# KOSIS 국가통계포털 인증키. 통계 시계열(전망 백테스트)
KOSIS_API_KEY=
# 법제처 국가법령정보 OC 값 = 회원 ID(이메일 @ 앞부분). 법령·개정 연혁
LAW_GO_KR_OC=
# 열린국회정보 인증키. 의안·회의록
ASSEMBLY_API_KEY=
# 한국은행 ECOS 인증키. 거시 변수
ECOS_API_KEY=
# KCI 직접 API 키 (공공데이터포털이 되면 생략 가능)
KCI_API_KEY=
# 국회도서관 Open API 키 (승인 최대 7 업무일)
NANET_API_KEY=
# ScienceON(KISTI) 키. 국내 논문·특허·연구보고서
SCIENCEON_API_KEY=

# ===== 근거 소스: 해외 무료 키 (선택) =====
# IEEE Xplore Metadata 키
IEEE_API_KEY=
# CORE(오픈액세스 원문) 키
CORE_API_KEY=
# Springer Nature 키
SPRINGER_API_KEY=
# Lens.org API 토큰
LENS_API_TOKEN=

# ===== 근거 소스: 유료·기관 구독 (있을 때만) =====
# Scopus(Elsevier) 키
ELSEVIER_API_KEY=
# Scopus 기관 InstToken (기관 IP 밖에서 쓸 때)
ELSEVIER_INSTTOKEN=
# Web of Science 키
WOS_API_KEY=
# Dimensions 키
DIMENSIONS_API_KEY=
# Perplexity Sonar 키
PERPLEXITY_API_KEY=
# SerpAPI(Google Scholar) 키
SERPAPI_API_KEY=
# DBpia 기관 계약 키
DBPIA_API_KEY=
# BigKinds 키
BIGKINDS_API_KEY=
