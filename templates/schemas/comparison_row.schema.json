{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "신구 대조표 행",
 "type": "object",
 "description": "결론 행(conclusion_id·kind 보유)과 본문 행(level·change_type 보유) 두 가지 모양을 한 스키마로 받는다. level이 있으면 change_type을, 없으면 conclusion_id·kind를 요구한다.",
 "required": [
  "row_id",
  "location",
  "old",
  "new",
  "grade",
  "status"
 ],
 "if": {
  "required": [
   "level"
  ]
 },
 "then": {
  "required": [
   "change_type"
  ]
 },
 "else": {
  "required": [
   "conclusion_id",
   "kind"
  ]
 },
 "properties": {
  "row_id": {
   "type": "string"
  },
  "level": {
   "enum": [
    "conclusion",
    "section",
    "table",
    "claim",
    "recommendation"
   ]
  },
  "conclusion_id": {
   "type": "string"
  },
  "kind": {
   "enum": [
    "RQ",
    "F",
    "Fc",
    "R"
   ]
  },
  "location": {
   "type": "string"
  },
  "old": {
   "type": "string"
  },
  "new": {
   "type": "string"
  },
  "change_type": {
   "enum": [
    "유지",
    "수치갱신",
    "서술수정",
    "폐기",
    "신규추가",
    "재수행필요"
   ]
  },
  "verdict": {
   "enum": [
    "",
    "잠정",
    "동일",
    "강화",
    "부분수정",
    "약화",
    "뒤집힘",
    "신규결론",
    "판정불가"
   ],
   "description": "최종 판정 7종. 빈 값 또는 '잠정'은 아직 최종 판정 전(L0 잠정 상태)"
  },
  "next_action": {
   "enum": [
    "유지",
    "부록 갱신",
    "재연구 발주",
    "폐기(아카이브)",
    "추가 조사(설계서)"
   ]
  },
  "reason_locus": {
   "type": "array",
   "items": {
    "enum": [
     "P",
     "E",
     "M"
    ]
   }
  },
  "reason": {
   "type": "string"
  },
  "evidence_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "url",
     "grade"
    ],
    "properties": {
     "url": {
      "type": "string"
     },
     "grade": {
      "enum": [
       "A",
       "B",
       "C"
      ]
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "grade": {
   "enum": [
    "A",
    "B",
    "C"
   ]
  },
  "status": {
   "enum": [
    "L0 잠정",
    "L1 근거갱신",
    "L2 최종",
    "R3 설계서"
   ]
  },
  "linked_conclusions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "upstream": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "blind_new": {
   "type": "string"
  },
  "comparability": {
   "enum": [
    "직접비교 가능",
    "대체지표 비교",
    "비교 불가"
   ],
   "description": "선택. 과거 자료와 최신 자료를 같은 잣대로 볼 수 있는지. 비교기가 스스로 채운다."
  },
  "comparability_note": {
   "type": "string",
   "description": "선택. 무엇이 같고 무엇이 달라 그렇게 보았는지(정의·모집단·집계기준·단위·시점)."
  },
  "method_changed": {
   "type": "boolean",
   "description": "선택. 원 방법을 그대로 썼으면 false, 바꿨으면 true. 비교기가 스스로 채운다."
  },
  "method_change_note": {
   "type": "string",
   "description": "선택. 바꿨다면 무엇을 어떻게 바꿨는지(대체 지표·모형·파라미터·기준연도)."
  },
  "evidence_floor_ok": {
   "type": "boolean",
   "description": "선택. 이 판정이 C등급 추정만으로 내려진 것이 아님을 확인했으면 true. A/B 근거 없이 C만 있으면 false."
  },
  "approval": {
   "type": [
    "object",
    "null"
   ],
   "description": "선택. 사람이 채우는 칸. 비교기·자동 도구는 비워 둔다(키를 만들지 않거나 null).",
   "properties": {
    "approver": {
     "type": "string"
    },
    "approved_at": {
     "type": "string",
     "description": "ISO 8601 (예: 2026-09-18 또는 2026-09-18T14:30:00+09:00)"
    },
    "decision": {
     "enum": [
      "승인",
      "보류",
      "반려"
     ]
    },
    "comment": {
     "type": "string"
    }
   }
  }
 }
}